{% render 'paw-divider' %}
<section class="section-pad" style="padding-top:0">
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.title }}</h2>
      {% if section.settings.collection %}
        <a class="btn btn--ghost" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>
      {% endif %}
    </div>
    <div class="product-grid">
      {% assign col = section.settings.collection %}
      {% if col != blank %}
        {% for product in col.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="product-card"><div class="product-card__img"></div><div class="product-card__body"><span class="product-card__title">Товар {{ i }}</span><span class="product-card__price">0 ₴</span></div></div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Meilleures ventes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
